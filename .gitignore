# .gitignore for .NET and Angular

# .NET
bin/
obj/
*.user
*.userosscache
*.sln.docstates
.vs/
.vscode/

# Ignore backend build outputs explicitly (untrack already committed files)
/backend/bin/
/backend/obj/
/backend/*.exe
/backend/*.dll
/backend/*.pdb
/backend/*.sourcelink.json

# Angular
node_modules/
dist/
.angular/
.editorconfig
src/assets/i18n/*.json
src/environments/environment.prod.ts

# Misc
.DS_Store
*.log
.env
build_errors.txt
